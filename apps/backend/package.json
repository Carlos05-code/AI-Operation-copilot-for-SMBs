{
  "name": "@smb-copilot/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Operations Copilot — NestJS API (modular monolith)",
  "packageManager": "pnpm@9.15.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r ./dist/shared/telemetry/preload.js dist/main.js",
    "start:worker": "node -r ./dist/shared/telemetry/preload.js dist/main-worker.js",
    "start:dev": "tsc -p tsconfig.json && node -r ./dist/shared/telemetry/preload.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" --max-warnings 0",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern src",
    "test:e2e": "jest --runInBand --testPathPattern test",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^8.0.2",
    "@opensearch-project/opensearch": "^3.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "6.19.3",
    "@qdrant/js-client-rest": "^1.19.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bullmq": "^6.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.7",
    "minio": "^8.0.7",
    "neo4j-driver": "^6.2.0",
    "nodemailer": "^10.0.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-loki": "^3.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.3",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.23.4"
  },
  "engines": {
    "node": ">=20"
  }
}

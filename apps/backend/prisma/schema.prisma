// AI Operations Copilot — PostgreSQL schema (DATABASE_SPEC §3, §8)
// Single source of truth for the system-of-record relational data.
// Conventions: snake_case plural tables, uuid PKs, `<table>_id` FKs,
// `idx_<table>_<column>` index names (DATABASE_SPEC §2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity & tenancy ────────────────────────────────────────────────────

model Organization {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  tenant                  TenantType               @default(SINGLE)
  plan                    PlanType                 @default(FREE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  members                 Member[]
  customers               Customer[]
  products                Product[]
  salesOrders             SalesOrder[]
  invoices                Invoice[]
  recurringInvoices       RecurringInvoice[]
  tasks                   Task[]
  documents               Document[]
  conversations           Conversation[]
  knowledgeDocuments      KnowledgeDocument[]
  auditLogs               AuditLog[]
  appointments            Appointment[]
  purchaseRecommendations PurchaseRecommendation[]
  workflowRules           WorkflowRule[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  authId    String?  @map("auth_id")
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   Member[]

  @@index([email])
  @@map("users")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

model Member {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           Role         @default(VIEWER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

// ── Commerce core ─────────────────────────────────────────────────────────

model Customer {
  id                String             @id @default(uuid())
  organizationId    String             @map("organization_id")
  name              String
  phone             String?
  email             String?
  whatsapp          String?
  address           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrders       SalesOrder[]
  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  conversations     Conversation[]
  appointments      Appointment[]

  @@index([organizationId])
  @@map("customers")
}

model Product {
  id                      String                   @id @default(uuid())
  organizationId          String                   @map("organization_id")
  name                    String
  sku                     String
  price                   Decimal                  @db.Decimal(12, 2)
  cost                    Decimal?                 @db.Decimal(12, 2)
  reorderPoint            Int?                     @default(0) @map("reorder_point")
  belowReorderPoint       Boolean                  @default(false) @map("below_reorder_point")
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryMovements      InventoryMovement[]
  lineItems               SalesLineItem[]
  purchaseRecommendations PurchaseRecommendation[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([active, reorderPoint])
  @@map("products")
}

model InventoryMovement {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  quantity  Int
  type      MovementType @default(IN)
  note      String?
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("inventory_movements")
}

enum MovementType {
  IN
  OUT
  ADJUST
}

enum PurchaseRecommendationStatus {
  PENDING
  ORDERED
  DISMISSED
}

/**
 * PurchaseRecommendation: AI-generated reorder suggestion (ROADMAP Phase 3 —
 * purchase recommendations, AI_ARCHITECTURE §6.1 `recommend.reorder`).
 * One row per product per below-reorder-point episode; `agentMetadata`
 * carries the prompt version and the signal snapshot the model reasoned
 * over. `PENDING` is the only actionable state — `ORDERED`/`DISMISSED` are
 * terminal so a resolved recommendation is never re-surfaced (a fresh dip
 * generates a new row once the product recovers and drops below the
 * reorder point again).
 */
model PurchaseRecommendation {
  id                  String                       @id @default(uuid())
  organizationId      String                       @map("organization_id")
  productId           String                       @map("product_id")
  recommendedQuantity Int                          @map("recommended_quantity")
  reason              String
  status              PurchaseRecommendationStatus @default(PENDING)
  agentMetadata       Json?                        @map("agent_metadata")
  resolvedAt          DateTime?                    @map("resolved_at")
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product             Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([productId, status])
  @@map("purchase_recommendations")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  CANCELLED
}

model SalesOrder {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  customerId     String          @map("customer_id")
  status         OrderStatus     @default(DRAFT)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lineItems      SalesLineItem[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("sales_orders")
}

model SalesLineItem {
  id        String     @id @default(uuid())
  orderId   String     @map("order_id")
  productId String     @map("product_id")
  quantity  Int
  unitPrice Decimal    @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal    @map("line_total") @db.Decimal(12, 2)
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("sales_line_items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id                 String            @id @default(uuid())
  organizationId     String            @map("organization_id")
  customerId         String            @map("customer_id")
  recurringInvoiceId String?           @map("recurring_invoice_id")
  invoiceNumber      String            @map("invoice_number")
  dueDate            DateTime          @map("due_date")
  status             InvoiceStatus     @default(DRAFT)
  note               String?
  subtotal           Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal           @default(0) @map("tax_total") @db.Decimal(12, 2)
  total              Decimal           @default(0) @db.Decimal(12, 2)
  issuedAt           DateTime?         @map("issued_at")
  paidAt             DateTime?         @map("paid_at")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  items              InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([status, dueDate])
  @@index([recurringInvoiceId])
  @@map("invoices")
}

enum RecurrenceCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A billing schedule that generates invoices on a fixed cadence
/// (ROADMAP Phase 3 — recurring invoicing). `lineItems` stores the invoice
/// template as JSON: `[{ productId?, description, quantity, unitPrice, taxRate }]`.
model RecurringInvoice {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  customerId     String            @map("customer_id")
  cadence        RecurrenceCadence @default(MONTHLY)
  interval       Int               @default(1)
  netTermsDays   Int               @default(30) @map("net_terms_days")
  issueOnCreate  Boolean           @default(true) @map("issue_on_create")
  active         Boolean           @default(true)
  note           String?
  lineItems      Json              @map("line_items")
  nextRunAt      DateTime          @map("next_run_at")
  lastRunAt      DateTime?         @map("last_run_at")
  generatedCount Int               @default(0) @map("generated_count")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoices       Invoice[]

  @@index([organizationId, active])
  @@index([active, nextRunAt])
  @@map("recurring_invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  productId   String? @map("product_id")
  description String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// ── Operations & AI ───────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  assigneeId     String?      @map("assignee_id")
  title          String
  description    String?
  dueDate        DateTime?    @map("due_date")
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  agentMetadata  Json?        @map("agent_metadata")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, assigneeId])
  @@map("tasks")
}

enum WorkflowTriggerEntity {
  INVOICE
  PRODUCT
  TASK
  APPOINTMENT
}

/**
 * WorkflowRule: an org-defined "when <conditions on an entity type>, do
 * <actions>" automation (ROADMAP Phase 4 — visual workflow builder /
 * rules engine, stretch). `conditions` and `actions` are structured JSON
 * (not free-form code) — a future visual builder targets this same shape.
 * Fires once per entity, ever: each match is recorded as a `WorkflowRun`
 * (`@@unique([ruleId, entityId])`), which both dedupes and gives a full
 * audit trail of what a rule has done.
 */
model WorkflowRule {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  name           String
  triggerEntity  WorkflowTriggerEntity @map("trigger_entity")
  conditions     Json
  actions        Json
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs           WorkflowRun[]

  @@index([organizationId, active])
  @@map("workflow_rules")
}

model WorkflowRun {
  id         String       @id @default(uuid())
  ruleId     String       @map("rule_id")
  entityId   String       @map("entity_id")
  actionsRun Json         @map("actions_run")
  createdAt  DateTime     @default(now())
  rule       WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, entityId])
  @@index([ruleId])
  @@map("workflow_runs")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// A booked time window, optionally with a customer and an assigned staff
/// member (ROADMAP Phase 3 — appointment scheduling). `assigneeId` mirrors
/// `Task.assigneeId` — a bare id, no FK relation to `User`.
model Appointment {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  customerId     String?           @map("customer_id")
  assigneeId     String?           @map("assignee_id")
  title          String
  notes          String?
  startAt        DateTime          @map("start_at")
  endAt          DateTime          @map("end_at")
  status         AppointmentStatus @default(SCHEDULED)
  reminderSentAt DateTime?         @map("reminder_sent_at")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, startAt])
  @@index([assigneeId, startAt])
  @@index([status, startAt])
  @@map("appointments")
}

model Document {
  id                String             @id @default(uuid())
  organizationId    String             @map("organization_id")
  fileName          String             @map("file_name")
  contentType       String             @map("content_type")
  sizeBytes         Int                @map("size_bytes")
  storageKey        String             @map("storage_key")
  cleanTextKey      String?            @map("clean_text_key")
  status            DocumentStatus     @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeDocument KnowledgeDocument?

  @@index([organizationId])
  @@map("documents")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

model KnowledgeDocument {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  documentId     String       @unique @map("document_id")
  title          String
  objectKey      String       @map("object_key")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("knowledge_documents")
}

// ── Customer conversations (DATABASE_SPEC §3) ─────────────────────────────

enum ConversationChannel {
  WHATSAPP
  EMAIL
  SLACK
}

enum MessageSender {
  CUSTOMER
  AGENT
  SYSTEM
}

model Conversation {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  customerId         String?             @map("customer_id")
  channel            ConversationChannel @default(WHATSAPP)
  externalId         String?             @map("external_id")
  title              String?
  summary            String?             @map("summary")
  summaryGeneratedAt DateTime?           @map("summary_generated_at")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages           Message[]

  @@unique([organizationId, externalId])
  @@index([organizationId, channel])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  sender         MessageSender @default(CUSTOMER)
  body           String
  sentAt         DateTime      @map("sent_at")
  externalId     String?       @map("external_id")
  createdAt      DateTime      @default(now())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
  @@map("messages")
}

enum NotificationKind {
  IN_APP
  WHATSAPP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id             String                     @id @default(uuid())
  organizationId String                     @map("organization_id")
  userId         String                     @map("user_id")
  kind           NotificationKind           @default(IN_APP)
  title          String
  body           String?
  payload        Json?
  readAt         DateTime?                  @map("read_at")
  deliveryStatus NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveredAt    DateTime?                  @map("delivered_at")
  deliveryError  String?                    @map("delivery_error")
  createdAt      DateTime                   @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([deliveryStatus, createdAt])
  @@map("notifications")
}

// ── Audit & outbox (DATABASE_SPEC §10) ────────────────────────────────────

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  actorUserId    String?       @map("actor_user_id")
  action         String
  resourceType   String        @map("resource_type")
  resourceId     String?       @map("resource_id")
  metadata       Json?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  processedAt   DateTime?    @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum TenantType {
  SINGLE
  GROUP
}

enum PlanType {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

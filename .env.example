# ------------------------------------------------------------------
# AI Operations Copilot — environment variables (reference)
# NEVER commit real secrets. Copy to `.env` and fill locally.
# ------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smb_copilot
POSTGRES_USER=admin
POSTGRES_PASSWORD=__CHANGE_ME__
DATABASE_URL=postgresql://admin:__CHANGE_ME__@localhost:5432/smb_copilot

# Knowledge graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__CHANGE_ME__
NEO4J_DATABASE=neo4j

# Vector database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings (any OpenAI-compatible /embeddings endpoint: BGE-M3 via vLLM, OpenAI, ...)
EMBEDDINGS_API_URL=http://localhost:8000/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIMENSION=1024

# Full-text search (OpenSearch)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=__CHANGE_ME__

# Cache & queues (Redis)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Object storage (MinIO / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=smb-copilot
STORAGE_ACCESS_KEY=__CHANGE_ME__
STORAGE_SECRET_KEY=__CHANGE_ME__
STORAGE_REGION=us-east-1

# Messaging (RabbitMQ)
RABBITMQ_URL=amqp://user:__CHANGE_ME__@localhost:5672
RABBITMQ_VHOST=/

# Identity (Keycloak)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=smb-copilot
KEYCLOAK_CLIENT_ID=smb-copilot-ui
KEYCLOAK_CLIENT_SECRET=__CHANGE_ME__

# Auths
JWT_ACCESS_TOKEN_SECRET=__CHANGE_ME__
JWT_REFRESH_TOKEN_SECRET=__CHANGE_ME__
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# JWT verification (Keycloak JWKS; backend)
AUTH_JWKS_URL=http://localhost:8080/realms/smb-copilot/protocol/openid-connect/certs
AUTH_ISSUER=http://localhost:8080/realms/smb-copilot
AUTH_AUDIENCE=smb-copilot-api

# AI / LLM (any OpenAI-compatible /chat/completions endpoint: OpenAI, Azure, vLLM, ...)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o

# OCR
OCR_ENGINE=paddle

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_SCRAPE_PORT=9464

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Seed
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=__CHANGE_ME__